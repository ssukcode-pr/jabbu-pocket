{
	"name": "jabbu-pocket",
	"version": "0.1.1",
	"private": true,
	"license": "MIT",
	"type": "module",
	"packageManager": "bun@1.4.4",
	"engines": {
		"bun": ">=1.4.4"
	},
	"bin": {
		"jabbu-pocket": "src/main.ts"
	},
	"scripts": {
		"test": "scripts/heavy-run -- bun test --parallel=3",
		"check": "biome check --error-on-warnings . && tsc --noEmit && bun src/dev/test-sleeps.ts && bun src/dev/check-loc.ts && bun scripts/tla-covered.ts",
		"knip": "knip",
		"smoke-omp": "JABBU_E2E_OMP=1 bun test test/omp-smoke.e2e.test.ts test/omp-rpc.contract.test.ts",
		"test:omp-mock": "JABBU_E2E_OMP_MOCK=1 bun test test/omp-mock.e2e.test.ts"
	},
	"dependencies": {
		"@json-render/chat": "0.23.2",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@types/bun": "^1.4.5",
		"chat": "^4.45.0",
		"knip": "^6.47.0",
		"typescript": "^7.0.2"
	}
}
